# Generic OpenAI-Compatible LLM Provider Configuration
# Works with Groq (https://console.groq.com/), OpenRouter, OpenAI, vLLM, LM Studio, Ollama, etc.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1

# Qdrant Vector Database (Required for semantic & vector search)
# Get a free cloud cluster at: https://cloud.qdrant.io/ or use http://localhost:6333 for local docker
QDRANT_URL=https://your-cluster-url.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# AWS S3 Storage (Required for document upload & storage)
S3_BUCKET=medical-rag-documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Supabase Database (Required for Dev Mode trace logging & AI-Judge evaluations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Embedding & Reranker Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
LLM_MODEL=openai/gpt-oss-20b

# Chunking & Document Processing Configuration
MAX_FILE_SIZE_MB=50
SEMANTIC_CHUNK_THRESHOLD=0.50
RECURSIVE_CHUNK_SIZE=512
RECURSIVE_CHUNK_OVERLAP=64

# Retrieval, Reranking & Evaluation Thresholds
RETRIEVAL_TOP_K=10
RERANKER_TOP_K=5
DEDUP_OVERLAP_THRESHOLD=0.8
EVIDENCE_THRESHOLD=0.4
COLLECTION_NAME=medical_documents
